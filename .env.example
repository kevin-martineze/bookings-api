# Copy to .env and fill in. Never commit the filled version.

# --- Base de datos -----------------------------------------------------------
# Postgres. El proveedor da igual (Neon, Railway, Render, Docker local): esto es
# solo una cadena de conexión.
#
# DATABASE_URL  la usa la aplicación. Si el proveedor ofrece pooler, va la del
#               pooler.
# DIRECT_URL    la usan las migraciones. Debe ser la conexión SIN pooler: los
#               poolers en modo transacción rompen `prisma migrate`. Si el
#               proveedor no distingue, repite la misma URL.
DATABASE_URL="postgresql://user:password@host:5432/postgres?schema=public"
DIRECT_URL="postgresql://user:password@host:5432/postgres?schema=public"

# --- Autenticación -----------------------------------------------------------
# Secretos de firma de los JWT. Distintos entre sí: si el de acceso se filtra,
# no debe servir para forjar un refresh.
# Generar con: openssl rand -base64 48
JWT_ACCESS_SECRET=""
JWT_REFRESH_SECRET=""

# El access token se mantiene corto porque no se puede revocar una vez emitido.
# La sesión larga la sostiene el refresh, que sí es revocable.
JWT_ACCESS_TTL="15m"
JWT_REFRESH_TTL="30d"

# --- Servidor ----------------------------------------------------------------
PORT=3000
# Orígenes permitidos: el sitio del huésped (Astro) y el panel (Next.js).
CORS_ORIGINS="http://localhost:4321,http://localhost:3001"

# --- Sitio público -----------------------------------------------------------
# Reservas que una misma IP puede crear por hora. Cada una retiene una
# habitación real durante 48 h, así que en producción va bajo (5).
# En desarrollo conviene subirlo para poder probar el formulario.
PUBLIC_BOOKING_LIMIT_PER_HOUR=5

# --- Correo transaccional ----------------------------------------------------
# ethereal | smtp | log
#   ethereal  Desarrollo. Casilla descartable creada al vuelo; cada correo deja
#             una URL en el log para verlo renderizado. Sin cuenta ni dominio.
#   smtp      Mailpit local, o el proveedor real en producción.
#   log       Sólo escribe en el log. El de emergencia.
MAIL_TRANSPORT=ethereal
MAIL_FROM="Daughters of Sun <reservas@eldominio.com>"

# Sólo con MAIL_TRANSPORT=smtp
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=

# Base del panel: se usa para armar el enlace de restablecimiento del correo.
PANEL_URL=https://admin.eldominio.com

# Sólo con MAIL_TRANSPORT=ethereal. Opcional.
# Con credenciales fijas, todos los correos de prueba caen en la misma bandeja
# y se ven entrando en https://ethereal.email. Sin ellas se crea una cuenta
# descartable en cada arranque y cada mensaje sólo se alcanza por la URL que
# queda en el log.
ETHEREAL_USER=
ETHEREAL_PASSWORD=
