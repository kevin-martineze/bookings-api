# Copy to .env and fill in. Never commit the filled version.

# Postgres. Supabase gives two URLs: use the pooled one for the app and the
# direct one for migrations, or Prisma's migrate will fail against the pooler.
DATABASE_URL="postgresql://user:password@host:5432/postgres?schema=public"
DIRECT_URL="postgresql://user:password@host:5432/postgres?schema=public"

# Identity provider. The API never stores passwords — it validates the token
# issued by this provider and maps it to a row in `users`.
SUPABASE_URL=""
SUPABASE_JWT_SECRET=""

PORT=3000
# Origins allowed to call the API: the Astro guest site and the Next.js panel.
CORS_ORIGINS="http://localhost:4321,http://localhost:3001"
