// PMS multi-inquilino.
//
// Reglas que sostienen todo lo demás:
//
//  1. TODO dato de negocio cuelga de una Organization. No existe una fila
//     "global" que un inquilino pueda ver por accidente.
//  2. Las reservas se atan a una Unit FÍSICA, nunca a un UnitType. Es lo único
//     que hace posible la restricción de exclusión que impide la doble reserva
//     (ver migrations/.../exclusion). Un contador por tipo no se puede proteger
//     igual bajo concurrencia.
//  3. El dinero se guarda en enteros de la unidad mínima (centavos). Nunca
//     Float: 0.1 + 0.2 no es 0.3 y una factura no puede depender de eso.

generator client {
  provider = "prisma-client-js"
}

// Prisma 7 sacó las URLs de conexión del schema. La de migraciones vive en
// prisma.config.ts y la de runtime entra por el adapter que recibe PrismaClient
// (ver src/prisma/prisma.service.ts).
//
// Postgres y no un motor de documentos por una razón concreta: la restricción
// de exclusión que impide la doble reserva. Ningún motor NoSQL ofrece una
// garantía equivalente de no-solapamiento de rangos, y replicarla a mano deja
// una ventana de carrera justo donde más caro sale.
datasource db {
  provider = "postgresql"
}

// ---------------------------------------------------------------------------
// Inquilinos e identidad
// ---------------------------------------------------------------------------

/// Un inquilino: la empresa que opera uno o más alojamientos.
model Organization {
  id        String   @id @default(uuid()) @db.Uuid
  name      String
  /// Subdominio o identificador en URLs. Único en toda la plataforma.
  slug      String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  memberships Membership[]
  properties  Property[]
  guests      Guest[]
  bookings    Booking[]
  payments    Payment[]

  @@map("organizations")
}

/// Cuenta de acceso, una sola tabla para huéspedes y personal.
///
/// Lo que distingue a un empleado no es estar en otra tabla, sino tener una
/// Membership en alguna organización. Así una misma persona puede trabajar en
/// una propiedad y reservar en otra con la misma cuenta, y el flujo de login es
/// uno solo en vez de dos.
model User {
  id       String  @id @default(uuid()) @db.Uuid
  email    String  @unique
  fullName String? @map("full_name")

  /// Hash argon2id. Nunca se serializa en una respuesta ni se escribe a logs.
  /// Nullable para permitir a futuro cuentas creadas por el personal que aún no
  /// han fijado contraseña, y para dejar la puerta abierta a login social.
  passwordHash String? @map("password_hash")

  emailVerifiedAt DateTime? @map("email_verified_at")

  /// Freno a la fuerza bruta. El límite por IP vive en el throttler; esto
  /// protege a una cuenta concreta atacada desde muchas direcciones.
  failedLoginAttempts Int       @default(0) @map("failed_login_attempts")
  lockedUntil         DateTime? @map("locked_until")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  memberships   Membership[]
  /// Perfiles de huésped enlazados a esta cuenta, uno por organización.
  guests        Guest[]
  refreshTokens RefreshToken[]
  tokens        VerificationToken[]

  @@map("users")
}

enum TokenPurpose {
  EMAIL_VERIFICATION
  PASSWORD_RESET

  @@map("token_purpose")
}

/// Tokens de un solo uso enviados por correo.
///
/// Se guarda el SHA-256, nunca el token en claro: el valor real solo existe en
/// el correo del usuario. Si alguien lee esta tabla no puede tomar cuentas ni
/// completar un restablecimiento.
model VerificationToken {
  id      String       @id @default(uuid()) @db.Uuid
  userId  String       @map("user_id") @db.Uuid
  purpose TokenPurpose

  tokenHash  String    @unique @map("token_hash")
  expiresAt  DateTime  @map("expires_at")
  /// Marca el uso. Un token consumido no vuelve a servir aunque no haya vencido.
  consumedAt DateTime? @map("consumed_at")

  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, purpose])
  @@map("verification_tokens")
}

/// Refresh tokens con rotación.
///
/// Cada uso emite uno nuevo y revoca el anterior. `familyId` encadena toda la
/// descendencia de un login: si llega un token YA rotado, significa que alguien
/// se quedó con una copia, así que se revoca la familia completa y se fuerza a
/// entrar de nuevo. Sin esa detección, un token robado sirve indefinidamente.
model RefreshToken {
  id     String @id @default(uuid()) @db.Uuid
  userId String @map("user_id") @db.Uuid

  tokenHash String @unique @map("token_hash")
  familyId  String @map("family_id") @db.Uuid

  expiresAt DateTime  @map("expires_at")
  revokedAt DateTime? @map("revoked_at")

  /// Contexto para que el usuario reconozca sus sesiones y pueda cerrarlas.
  userAgent String? @map("user_agent")
  ip        String?

  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([familyId])
  @@map("refresh_tokens")
}

enum MemberRole {
  OWNER
  MANAGER
  FRONT_DESK
  HOUSEKEEPING

  @@map("member_role")
}

/// Pertenencia de un usuario a una organización, con su rol.
/// Es la tabla que el guard de la API consulta para autorizar cada petición.
model Membership {
  id     String     @id @default(uuid()) @db.Uuid
  orgId  String     @map("org_id") @db.Uuid
  userId String     @map("user_id") @db.Uuid
  role   MemberRole

  createdAt DateTime @default(now())

  organization Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([orgId, userId])
  @@index([userId])
  @@map("memberships")
}

// ---------------------------------------------------------------------------
// Inventario
// ---------------------------------------------------------------------------

/// Un alojamiento físico: hotel, aparthotel, complejo.
model Property {
  id       String  @id @default(uuid()) @db.Uuid
  orgId    String  @map("org_id") @db.Uuid
  name     String
  slug     String
  timezone String  @default("UTC")

  addressLine String? @map("address_line")
  locality    String?
  region      String?
  postalCode  String? @map("postal_code")
  /// ISO 3166-1 alpha-2. Define impuestos y pasarela disponible.
  country     String?
  lat         Decimal? @db.Decimal(9, 6)
  lng         Decimal? @db.Decimal(9, 6)

  /// Moneda en la que se publican las tarifas. ISO 4217.
  currency String @default("USD")
  checkIn  String @default("15:00")
  checkOut String @default("11:00")

  /// Impuesto sobre hospedaje, en porcentaje entero. 10 es el ITBMS panameño.
  ///
  /// Vive como dato de la propiedad y no como constante en el código: si la
  /// tasa cambia, o si entra un alojamiento con otro tratamiento fiscal, es un
  /// UPDATE y no un despliegue. Las tarifas se publican SIN impuesto y este se
  /// suma al cotizar — por eso Booking guarda subtotal e impuesto por separado.
  taxRatePct Int @default(10) @map("tax_rate_pct")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  organization Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  unitTypes    UnitType[]
  units        Unit[]
  bookings     Booking[]

  @@unique([orgId, slug])
  @@map("properties")
}

/// Categoría vendible: "Standard Doble", "Suite con terraza".
/// Es lo que el huésped elige y sobre lo que se fija el precio.
model UnitType {
  id         String @id @default(uuid()) @db.Uuid
  orgId      String @map("org_id") @db.Uuid
  propertyId String @map("property_id") @db.Uuid

  name        String
  slug        String
  description String?

  maxGuests Int @map("max_guests")
  bedrooms  Int @default(0)
  beds      Int @default(1)
  /// Decimal porque medio baño es real.
  baths     Decimal @default(1) @db.Decimal(3, 1)
  sizeSqm   Int?    @map("size_sqm")

  /// Tarifa base por noche, en centavos. Las reglas por temporada viven en
  /// RatePlan; esto es el precio de referencia y el respaldo.
  basePriceMinor Int @map("base_price_minor")

  /// Noches mínimas por defecto. RatePlan puede sobrescribirlo por fecha.
  minNights Int @default(1) @map("min_nights")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  property  Property   @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  units     Unit[]
  ratePlans RatePlan[]
  bookings  Booking[]

  @@unique([propertyId, slug])
  @@index([orgId])
  @@map("unit_types")
}

/// Una unidad física reservable: la habitación 302, el apartamento B.
///
/// Existe aunque el negocio venda por tipo. Es el sujeto de la restricción de
/// exclusión, y sin ella no hay forma de impedir la doble reserva en la base.
model Unit {
  id         String @id @default(uuid()) @db.Uuid
  orgId      String @map("org_id") @db.Uuid
  propertyId String @map("property_id") @db.Uuid
  unitTypeId String @map("unit_type_id") @db.Uuid

  /// Identificador visible para el personal: "302", "Apto B".
  label String
  /// Fuera de servicio por mantenimiento: no se le asignan reservas nuevas.
  active Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  property Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  unitType UnitType @relation(fields: [unitTypeId], references: [id], onDelete: Restrict)
  bookings Booking[]

  @@unique([propertyId, label])
  @@index([orgId])
  @@index([unitTypeId])
  @@map("units")
}

/// Precio y restricciones para un rango de fechas. Permite temporada alta,
/// estadía mínima por fecha y cierres de venta.
model RatePlan {
  id         String @id @default(uuid()) @db.Uuid
  orgId      String @map("org_id") @db.Uuid
  unitTypeId String @map("unit_type_id") @db.Uuid

  name      String
  startDate DateTime @map("start_date") @db.Date
  /// Inclusivo. La noche del endDate se cobra a esta tarifa.
  endDate   DateTime @map("end_date") @db.Date

  priceMinor Int  @map("price_minor")

  /// Tarifa de las noches de viernes y sábado dentro de este rango.
  ///
  /// Null = el mismo precio todos los días. Existe porque el fin de semana es
  /// el producto de un hotel de playa con sports bar: sin este campo, cobrar
  /// más el viernes obligaría a crear un plan por cada fin de semana del año.
  ///
  /// Qué días cuentan como fin de semana es una decisión del hotel; acá son
  /// viernes y sábado — el domingo por la noche la gente se vuelve a casa.
  weekendPriceMinor Int? @map("weekend_price_minor")

  minNights  Int? @map("min_nights")
  /// Bloquea la venta en este rango sin borrar el plan.
  closed     Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  unitType UnitType @relation(fields: [unitTypeId], references: [id], onDelete: Cascade)

  @@index([orgId])
  @@index([unitTypeId, startDate, endDate])
  @@map("rate_plans")
}

// ---------------------------------------------------------------------------
// Huéspedes
// ---------------------------------------------------------------------------

/// Ficha del huésped, por organización.
///
/// Deliberadamente NO se guarda documento de identidad ni datos de tarjeta. Lo
/// primero exige justificación legal y política de retención; lo segundo nunca
/// debe tocar nuestros servidores — lo maneja la pasarela.
model Guest {
  id    String @id @default(uuid()) @db.Uuid
  orgId String @map("org_id") @db.Uuid

  /// Enlace a la cuenta cuando el huésped se registró en el sitio. Null para
  /// reservas que el personal carga a mano.
  userId String? @map("user_id") @db.Uuid

  fullName String  @map("full_name")
  email    String
  phone    String?
  /// Notas internas del personal. Nunca visibles para el huésped.
  notes    String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  organization Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  user         User?        @relation(fields: [userId], references: [id], onDelete: SetNull)
  bookings     Booking[]

  @@unique([orgId, email])
  @@index([userId])
  @@map("guests")
}

// ---------------------------------------------------------------------------
// Reservas
// ---------------------------------------------------------------------------

enum BookingStatus {
  /// Retención temporal mientras se completa el pago. Expira sola.
  PENDING
  CONFIRMED
  CHECKED_IN
  CHECKED_OUT
  CANCELLED
  NO_SHOW

  @@map("booking_status")
}

enum BookingSource {
  DIRECT
  STAFF
  /// Reservado para cuando entren los canales. Hoy sin uso.
  CHANNEL

  @@map("booking_source")
}

/// Una estadía.
///
/// `checkOut` es EXCLUSIVO: una reserva del 10 al 12 ocupa las noches 10 y 11,
/// y libera la unidad el día 12. Es lo que permite que una salida y una entrada
/// compartan fecha sin solaparse, y la migración construye el daterange como
/// [checkIn, checkOut) para que la exclusión respete esa semántica.
model Booking {
  id         String @id @default(uuid()) @db.Uuid
  orgId      String @map("org_id") @db.Uuid
  propertyId String @map("property_id") @db.Uuid
  unitTypeId String @map("unit_type_id") @db.Uuid
  /// Unidad física asignada. Se elige entre las libres del tipo al confirmar.
  unitId     String @map("unit_id") @db.Uuid
  guestId    String @map("guest_id") @db.Uuid

  /// Código corto que el huésped usa como referencia.
  reference String @unique

  checkIn  DateTime @map("check_in") @db.Date
  checkOut DateTime @map("check_out") @db.Date
  guests   Int      @default(1)

  status BookingStatus @default(PENDING)
  source BookingSource @default(DIRECT)

  /// Desglose congelado al momento de reservar. Se guarda el total calculado
  /// porque las tarifas cambian y una reserva pasada debe seguir cuadrando.
  subtotalMinor Int    @map("subtotal_minor")
  taxMinor      Int    @default(0) @map("tax_minor")
  feesMinor     Int    @default(0) @map("fees_minor")
  totalMinor    Int    @map("total_minor")
  currency      String

  /// Hasta cuándo vive una reserva PENDING sin pago. Un job la cancela después.
  holdExpiresAt DateTime? @map("hold_expires_at")

  guestNotes String?   @map("guest_notes")
  cancelledAt DateTime? @map("cancelled_at")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  organization Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  property     Property     @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  unitType     UnitType     @relation(fields: [unitTypeId], references: [id], onDelete: Restrict)
  unit         Unit         @relation(fields: [unitId], references: [id], onDelete: Restrict)
  guest        Guest        @relation(fields: [guestId], references: [id], onDelete: Restrict)
  payments     Payment[]

  @@index([orgId])
  @@index([propertyId, checkIn])
  @@index([unitId, checkIn])
  @@index([guestId])
  @@map("bookings")
}

// ---------------------------------------------------------------------------
// Pagos
// ---------------------------------------------------------------------------

enum PaymentStatus {
  PENDING
  AUTHORIZED
  PAID
  FAILED
  REFUNDED
  PARTIALLY_REFUNDED

  @@map("payment_status")
}

/// Registro de un intento de cobro.
///
/// El PMS no guarda datos de tarjeta ni mueve dinero: cada propiedad conecta su
/// propia cuenta de pasarela y aquí solo queda la referencia externa. Eso
/// mantiene el sistema fuera del alcance PCI y evita que la plataforma opere
/// como intermediario financiero.
model Payment {
  id        String @id @default(uuid()) @db.Uuid
  orgId     String @map("org_id") @db.Uuid
  bookingId String @map("booking_id") @db.Uuid

  /// "stripe", "mercadopago", "wompi"… La elección depende del país, que sigue
  /// sin definir, así que el campo es abierto a propósito.
  provider          String
  providerPaymentId String? @map("provider_payment_id")

  amountMinor   Int    @map("amount_minor")
  currency      String
  refundedMinor Int    @default(0) @map("refunded_minor")

  status PaymentStatus @default(PENDING)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  organization Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  booking      Booking      @relation(fields: [bookingId], references: [id], onDelete: Cascade)

  @@unique([provider, providerPaymentId])
  @@index([orgId])
  @@index([bookingId])
  @@map("payments")
}
